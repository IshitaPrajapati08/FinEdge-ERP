model PurchaseOrder {
  id        Int     @id @default(autoincrement())
  vendorId  Int
  vendor    Contact @relation(fields: [vendorId], references: [id])
  status    String  @default("DRAFT") // DRAFT, CONFIRMED, BILLED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PurchaseOrderLine[]
  vendorBill VendorBill?

  @@index([vendorId])
}

model PurchaseOrderLine {
  id              Int     @id @default(autoincrement())
  purchaseOrderId Int
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product @relation(fields: [productId], references: [id])
  qty             Int
  unitPrice       Decimal @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

model VendorBill {
  id              Int     @id @default(autoincrement())
  purchaseOrderId Int     @unique
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  invoiceDate     DateTime
  dueDate         DateTime?
  status          String  @default("UNPAID") // UNPAID, PAID
  journalEntryId  Int?
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments Payment[] @relation("PaymentToVendorBill")

  @@index([purchaseOrderId])
  @@index([journalEntryId])
}

model SalesOrder {
  id         Int     @id @default(autoincrement())
  customerId Int
  customer   Contact @relation(fields: [customerId], references: [id])
  status     String  @default("DRAFT") // DRAFT, CONFIRMED, INVOICED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lines SalesOrderLine[]
  customerInvoice CustomerInvoice?

  @@index([customerId])
}

model SalesOrderLine {
  id        Int     @id @default(autoincrement())
  salesOrderId Int
  salesOrder  SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId   Int
  product     Product @relation(fields: [productId], references: [id])
  qty         Int
  unitPrice   Decimal @db.Decimal(12, 2)
  tax         Decimal @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([salesOrderId])
  @@index([productId])
}

model CustomerInvoice {
  id              Int     @id @default(autoincrement())
  salesOrderId    Int     @unique
  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id])
  invoiceDate     DateTime
  dueDate         DateTime?
  status          String  @default("UNPAID") // UNPAID, PAID
  journalEntryId  Int?
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments Payment[] @relation("PaymentToCustomerInvoice")

  @@index([salesOrderId])
  @@index([journalEntryId])
}

model Payment {
  id              Int     @id @default(autoincrement())
  type            String  // cash, bank
  amount          Decimal @db.Decimal(12, 2)
  date            DateTime @default(now())
  linkedBillId    Int?
  linkedBill      VendorBill? @relation("PaymentToVendorBill", fields: [linkedBillId], references: [id])
  linkedInvoiceId Int?
  linkedInvoice   CustomerInvoice? @relation("PaymentToCustomerInvoice", fields: [linkedInvoiceId], references: [id])
  journalEntryId  Int?
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])
  status          String  @default("RECORDED") // RECORDED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([linkedBillId])
  @@index([linkedInvoiceId])
  @@index([journalEntryId])
}
