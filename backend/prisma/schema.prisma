// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  role      String   // admin, accountant, contact
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Contact {
  id        Int     @id @default(autoincrement())
  name      String
  type      String  // customer, vendor, both
  email     String?
  mobile    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseOrders  PurchaseOrder[]
  salesOrders     SalesOrder[]
}

model Product {
  id           Int     @id @default(autoincrement())
  name         String
  type         String  // furniture type
  salesPrice   Decimal @db.Decimal(12, 2)
  cost         Decimal @db.Decimal(12, 2)
  category     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  purchaseOrderLines  PurchaseOrderLine[]
  salesOrderLines     SalesOrderLine[]
}

model Account {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  type      String  // asset, liability, expense, income, capital
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  journalItems JournalItem[]
}

model Journal {
  id        Int     @id @default(autoincrement())
  name      String  @unique
  type      String  // sales, purchase, bank, cash
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries JournalEntry[]
}

model JournalEntry {
  id        Int     @id @default(autoincrement())
  journalId Int
  journal   Journal @relation(fields: [journalId], references: [id])
  date      DateTime @default(now())
  reference String?
  status    String  @default("POSTED") // POSTED, DRAFT
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items JournalItem[]
  vendorBills VendorBill[]
  customerInvoices CustomerInvoice[]
  payments Payment[]

  @@index([journalId])
  @@index([date])
}

